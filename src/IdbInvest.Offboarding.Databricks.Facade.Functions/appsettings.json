{
  "DataAccess": {
    "Provider": "DataMotion"
  },
  "DataMotion": {
    "BaseUrl": "https://idbinvestapi-d.iadb.org/datamotion-analytical-query-data-2/",
    "Warehouse": "warehouse_idbi_offboarding",
    "SubscriptionKey": "<key-vault-or-app-setting>",
    "AuthenticationMode": "DefaultAzureCredential",
    "AccessTokenScope": "2ff814a6-3304-4ab8-85cb-cd0e6f879c1d/.default",
    "PollIntervalMilliseconds": 750,
    "MaxPollSeconds": 30,
    "HealthTimeoutSeconds": 5,
    "MaxResultChunks": 100
  },
  "Databricks": {
    "Host": "https://adb-<workspace-id>.<region>.azuredatabricks.net",
    "WarehouseId": "<warehouse-id>",
    "AuthenticationMode": "DefaultAzureCredential",
    "WaitTimeoutSeconds": 30,
    "PollIntervalMilliseconds": 750,
    "MaxPollSeconds": 30,
    "HealthTimeoutSeconds": 5,
    "MaxResultChunks": 100
  },
  "SwaggerUi": {
    "StylesheetUrl": "https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui.css",
    "BundleUrl": "https://cdn.jsdelivr.net/npm/swagger-ui-dist@5/swagger-ui-bundle.js",
    "ContentSecurityPolicy": "default-src 'none'; script-src 'self' https://cdn.jsdelivr.net; style-src https://cdn.jsdelivr.net; img-src data:; connect-src 'self' https:; font-src https://cdn.jsdelivr.net data:"
  }
}
