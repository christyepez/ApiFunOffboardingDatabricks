              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200 or 503', function () { pm.expect([200,503]).to.include(pm.response.code); });",
                  "pm.test('Dependency health payload is coherent', function () { const b=pm.response.json(); pm.expect(['ok','degraded']).to.include(b.status); pm.expect(b.service).to.eql('Offboarding.Databricks.Facade'); pm.expect(['ok','unavailable']).to.include(b.databricks); if (b.databricks === 'ok') pm.response.to.have.status(200); else pm.response.to.have.status(503); });",
                  "pm.test('Correlation header is returned', function () { pm.expect(pm.response.headers.get('x-correlation-id')).to.be.a('string').and.not.empty; });",
                  "pm.test('Response disables caching', function () { pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });"
                ]
              }
            }
