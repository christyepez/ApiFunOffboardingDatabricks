  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Corporate Health Standard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text",
                "disabled": true
              }
            ],
            "url": "{{baseUrl}}/health",
            "description": "IDB standard deployable-app health endpoint. With baseUrl ending in /api, this calls GET /api/health. No bearer token is required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200 or 503', function () { pm.expect([200,503]).to.include(pm.response.code); });",
                  "pm.test('Corporate health payload is coherent', function () { const b=pm.response.json(); pm.expect(['Healthy','Unhealthy']).to.include(b.status); pm.expect(b.service).to.eql('Offboarding.Databricks.Facade'); pm.expect(['Healthy','Unhealthy']).to.include(b.databricks); if (b.status === 'Healthy') pm.response.to.have.status(200); else pm.response.to.have.status(503); });",
                  "pm.test('Correlation header is returned', function () { pm.expect(pm.response.headers.get('x-correlation-id')).to.be.a('string').and.not.empty; });",
                  "pm.test('Response disables caching', function () { pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Healthcheck",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}",
