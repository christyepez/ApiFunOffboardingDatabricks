{
  "info": {
    "_postman_id": "e366233e-df46-4ad8-8e88-e9cbdebe2181",
    "name": "IDB Invest - Offboarding Data Exposure API",
    "description": "Postman collection for execution, functional and contract testing of the governed read-only IDB Invest Offboarding Data Exposure API.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7071/api"
    },
    {
      "key": "functionKey",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.variables.set('correlationId', 'postman-' + pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Corporate Health Standard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}",
                "type": "text"
              }
            ],
            "url": "{{baseUrl}}/health",
            "description": "IDB standard deployable-app health endpoint. With baseUrl ending in /api, this calls GET /api/health. No bearer token is required."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200 or 503', function () { pm.expect([200,503]).to.include(pm.response.code); });",
                  "pm.test('Status follows IDB standard', function () { const b=pm.response.json(); pm.expect(['Healthy','Degraded','Unhealthy']).to.include(b.status); });",
                  "pm.test('Healthy/Degraded use 200 and Unhealthy uses 503', function () { const b=pm.response.json(); if (b.status === 'Unhealthy') pm.response.to.have.status(503); else pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Healthcheck",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "disabled": true
              }
            ],
            "url": "{{baseUrl}}/offboarding/v1/healthcheck"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "pm.test('Healthcheck status is ok', function () { const body = pm.response.json(); pm.expect(body.status).to.eql('ok'); });",
                  "pm.test('Databricks dependency is ok', function () { const body = pm.response.json(); pm.expect(body.databricks).to.eql('ok'); });",
                  "pm.test('Correlation ID is returned', function () { pm.expect(pm.response.json().correlationId).to.be.a('string').and.not.empty; });"
                ]
              }
            }
          ]
        },
        {
          "name": "Health check succeeds",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "disabled": true
              }
            ],
            "url": "{{baseUrl}}/offboarding/v1/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "pm.test('Health payload contains status', function () { const body = pm.response.json(); pm.expect(body).to.have.property('status'); });",
                  "pm.test('Response time is below 10 seconds', function () { pm.expect(pm.response.responseTime).to.be.below(10000); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/offboarding/v1/health/live",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "offboarding",
                "v1",
                "health",
                "live"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "pm.test('Status is ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/offboarding/v1/health/ready",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "offboarding",
                "v1",
                "health",
                "ready"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
                  "pm.test('Status is ok', function () { pm.expect(pm.response.json().status).to.eql('ok'); });",
                  "pm.test('Databricks is ready', function () { pm.expect(pm.response.json().databricks).to.eql('ok'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Metadata",
      "item": [
        {
          "name": "Employee metadata contract",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}"
              }
            ],
            "url": "{{baseUrl}}/offboarding/v1/resources/employees/metadata"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Metadata identifies the employees resource', function () { const body = pm.response.json(); pm.expect(body.resource).to.eql('employees'); });",
                  "pm.test('Metadata exposes fields and maximum page size', function () { const body = pm.response.json(); pm.expect(body.fields).to.be.an('array').that.is.not.empty; pm.expect(body.maxPageSize).to.be.a('number'); });",
                  "pm.test('Metadata does not expose physical Databricks source', function () { const raw = pm.response.text(); pm.expect(raw).not.to.include('gold.offboarding.vw_employees'); });",
                  "pm.test('Metadata exposes logical model and contract version', function () { const body = pm.response.json(); pm.expect(body.model).to.eql('employee-offboarding-candidate'); pm.expect(body.contractVersion).to.eql('1.0'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown resource returns 404",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}"
              }
            ],
            "url": "{{baseUrl}}/offboarding/v1/resources/not-a-resource/metadata"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 404', function () { pm.response.to.have.status(404); });",
                  "pm.test('Error contract contains code and correlationId', function () { const body = pm.response.json(); pm.expect(body).to.have.property('code'); pm.expect(body).to.have.property('correlationId'); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Dynamic Query",
      "item": [
        {
          "name": "Query employees with filters and paging",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/offboarding/v1/employees?fields=employeeId,fullName,status,department&filter=status:eq:OFFBOARDED&sort=-updatedAt&page=1&pageSize=100&includeTotal=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "offboarding",
                "v1",
                "employees"
              ],
              "query": [
                {
                  "key": "fields",
                  "value": "employeeId,fullName,status,department"
                },
                {
                  "key": "filter",
                  "value": "status:eq:OFFBOARDED"
                },
                {
                  "key": "sort",
                  "value": "-updatedAt"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "pageSize",
                  "value": "100"
                },
                {
                  "key": "includeTotal",
                  "value": "true"
                },
                {
                  "key": "code",
                  "value": "{{functionKey}}",
                  "disabled": true
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response follows query envelope contract', function () { const body = pm.response.json(); pm.expect(body.data).to.be.an('array'); pm.expect(body.meta).to.be.an('object'); });",
                  "pm.test('Paging metadata is present', function () { const meta = pm.response.json().meta; pm.expect(meta.page).to.eql(1); pm.expect(meta.pageSize).to.eql(100); pm.expect(meta).to.have.property('returned'); pm.expect(meta).to.have.property('hasMore'); });",
                  "pm.test('Correlation ID is returned in metadata', function () { const meta = pm.response.json().meta; pm.expect(meta.correlationId).to.be.a('string').and.not.empty; });",
                  "pm.test('Physical Databricks identifiers are not exposed', function () { const raw = pm.response.text(); pm.expect(raw).not.to.include('vw_employees'); pm.expect(raw).not.to.include('employee_id'); });",
                  "pm.test('Query metadata exposes logical contract version', function () { const meta = pm.response.json().meta; pm.expect(meta.model).to.eql('employee-offboarding-candidate'); pm.expect(meta.contractVersion).to.eql('1.0'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown field is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}"
              }
            ],
            "url": "{{baseUrl}}/offboarding/v1/employees?fields=employeeId,password&page=1&pageSize=100"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Invalid query uses normalized error contract', function () { const body = pm.response.json(); pm.expect(body.code).to.eql('INVALID_QUERY'); pm.expect(body).to.have.property('message'); pm.expect(body).to.have.property('correlationId'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Page size above resource limit is rejected",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}"
              }
            ],
            "url": "{{baseUrl}}/offboarding/v1/employees?page=1&pageSize=1001"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error code is INVALID_QUERY', function () { pm.expect(pm.response.json().code).to.eql('INVALID_QUERY'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Malformed filter does not echo submitted value",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text"
              },
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/offboarding/v1/employees?filter=email:invalid:private.person@iadb.org:extra",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "offboarding",
                "v1",
                "employees"
              ],
              "query": [
                {
                  "key": "filter",
                  "value": "email:invalid:private.person@iadb.org:extra"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 400', function () { pm.response.to.have.status(400); });",
                  "pm.test('Error does not echo submitted PII', function () { pm.expect(pm.response.text()).not.to.include('private.person@iadb.org'); });"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
