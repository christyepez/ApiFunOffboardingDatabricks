    {
      "name": "Dynamic Query",
      "item": [
        {
          "name": "Query employees with filters and paging",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "x-correlation-id",
                "value": "{{correlationId}}",
                "type": "text"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}",
                "type": "text",
                "disabled": true
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/offboarding/v1/{{resource}}?fields={{fields}}&filter={{filter}}&sort={{sort}}&page={{page}}&pageSize={{pageSize}}&includeTotal={{includeTotal}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "offboarding",
                "v1",
                "{{resource}}"
              ],
              "query": [
                {
                  "key": "fields",
                  "value": "{{fields}}"
                },
                {
                  "key": "filter",
                  "value": "{{filter}}"
                },
                {
                  "key": "sort",
                  "value": "{{sort}}"
                },
                {
                  "key": "page",
                  "value": "{{page}}"
                },
                {
                  "key": "pageSize",
                  "value": "{{pageSize}}"
                },
                {
                  "key": "includeTotal",
                  "value": "{{includeTotal}}"
                },
                {
                  "key": "code",
                  "value": "{{functionKey}}",
                  "disabled": true
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response follows query envelope contract', function () { const body=pm.response.json(); pm.expect(body.data).to.be.an('array'); pm.expect(body.meta).to.be.an('object'); });",
                  "pm.test('Paging metadata matches request', function () { const m=pm.response.json().meta; pm.expect(m.page).to.eql(Number(pm.variables.get('page') || pm.environment.get('page') || 1)); pm.expect(m.pageSize).to.eql(Number(pm.variables.get('pageSize') || pm.environment.get('pageSize') || 100)); pm.expect(m).to.have.property('returned'); pm.expect(m).to.have.property('hasMore'); });",
                  "pm.test('Logical model and contract version are exposed', function () { const m=pm.response.json().meta; pm.expect(m.model).to.eql('employee-offboarding-candidate'); pm.expect(m.contractVersion).to.eql('1.0'); });",
                  "pm.test('Physical Databricks identifiers are not exposed', function () { const raw=pm.response.text(); pm.expect(raw).not.to.include('vw_employees'); pm.expect(raw).not.to.include('employee_id'); });",
                  "pm.test('Correlation header is returned', function () { pm.expect(pm.response.headers.get('x-correlation-id')).to.be.a('string').and.not.empty; });",
                  "pm.test('Response disables caching', function () { pm.expect(pm.response.headers.get('Cache-Control')).to.include('no-store'); });"
                ]
              }
            }
          ]
        },
