                                                                                    "pm.test(\u0027Databricks dependency is ok\u0027, function () { const body = pm.response.json(); pm.expect(body.databricks).to.eql(\u0027ok\u0027); });",
                                                                                    "pm.test(\u0027Correlation ID is returned\u0027, function () { pm.expect(pm.response.json().correlationId).to.be.a(\u0027string\u0027).and.not.empty; });"
