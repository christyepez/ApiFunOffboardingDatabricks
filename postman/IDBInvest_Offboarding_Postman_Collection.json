  "info": {
    "_postman_id": "e366233e-df46-4ad8-8e88-e9cbdebe2181",
    "name": "IDB Invest - Offboarding Data Exposure API",
    "description": "Postman collection for functional, contract, health, pagination, filtering and security validation of the governed read-only IDB Invest Offboarding Data Exposure API. Import together with postman/local.postman_environment.json. Local Function base URL defaults to http://localhost:7071/api. In hosted environments set baseUrl to the APIM/API URL and provide accessToken when authentication is enforced.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7071/api"
    },
    {
      "key": "functionKey",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "resource",
      "value": "employees"
    },
    {
      "key": "fields",
      "value": "employeeId,fullName,email,status,department,country,terminationDate,updatedAt"
    },
    {
      "key": "filter",
      "value": "status:eq:OFFBOARDED"
    },
    {
      "key": "sort",
      "value": "-terminationDate,employeeId"
    },
    {
      "key": "page",
      "value": "1"
    },
    {
      "key": "pageSize",
      "value": "100"
    },
    {
      "key": "includeTotal",
      "value": "false"
    }
