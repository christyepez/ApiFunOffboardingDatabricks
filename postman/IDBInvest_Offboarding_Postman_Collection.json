                                                                                    "pm.test(\u0027Error contract contains code and correlationId\u0027, function () { const body = pm.response.json(); pm.expect(body).to.have.property(\u0027code\u0027); pm.expect(body).to.have.property(\u0027correlationId\u0027); });"
