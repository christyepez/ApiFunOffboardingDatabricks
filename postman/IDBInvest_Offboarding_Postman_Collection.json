                 },
                 {
                     "name":  "Dynamic Query",
                     "item":  [
                                  {
                                      "name":  "Query employees with filters and paging",
                                      "request":  {
                                                      "method":  "GET",
                                                      "header":  [
                                                                     {
                                                                         "key":  "x-correlation-id",
                                                                         "value":  "{{correlationId}}"
                                                                     }
                                                                 ],
                                                      "url":  {
                                                                  "raw":  "{{baseUrl}}/offboarding/v1/employees?fields=employeeId,fullName,status,department\u0026filter=status:eq:OFFBOARDED\u0026sort=-updatedAt\u0026page=1\u0026pageSize=100\u0026includeTotal=true",
                                                                  "host":  [
                                                                               "{{baseUrl}}"
                                                                           ],
                                                                  "path":  [
                                                                               "offboarding",
                                                                               "v1",
                                                                               "employees"
                                                                           ],
                                                                  "query":  [
                                                                                {
                                                                                    "key":  "fields",
                                                                                    "value":  "employeeId,fullName,status,department"
                                                                                },
                                                                                {
                                                                                    "key":  "filter",
                                                                                    "value":  "status:eq:OFFBOARDED"
                                                                                },
                                                                                {
                                                                                    "key":  "sort",
                                                                                    "value":  "-updatedAt"
                                                                                },
                                                                                {
                                                                                    "key":  "page",
                                                                                    "value":  "1"
                                                                                },
                                                                                {
                                                                                    "key":  "pageSize",
                                                                                    "value":  "100"
                                                                                },
                                                                                {
                                                                                    "key":  "includeTotal",
                                                                                    "value":  "true"
                                                                                },
                                                                                {
                                                                                    "key":  "code",
                                                                                    "value":  "{{functionKey}}",
                                                                                    "disabled":  true
                                                                                }
                                                                            ]
                                                              }
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027HTTP status is 200\u0027, function () { pm.response.to.have.status(200); });",
                                                                                    "pm.test(\u0027Response follows query envelope contract\u0027, function () { const body = pm.response.json(); pm.expect(body.data).to.be.an(\u0027array\u0027); pm.expect(body.meta).to.be.an(\u0027object\u0027); });",
                                                                                    "pm.test(\u0027Paging metadata is present\u0027, function () { const meta = pm.response.json().meta; pm.expect(meta.page).to.eql(1); pm.expect(meta.pageSize).to.eql(100); pm.expect(meta).to.have.property(\u0027returned\u0027); pm.expect(meta).to.have.property(\u0027hasMore\u0027); });",
                                                                                    "pm.test(\u0027Correlation ID is returned in metadata\u0027, function () { const meta = pm.response.json().meta; pm.expect(meta.correlationId).to.be.a(\u0027string\u0027).and.not.empty; });",
                                                                                    "pm.test(\u0027Physical Databricks identifiers are not exposed\u0027, function () { const raw = pm.response.text(); pm.expect(raw).not.to.include(\u0027vw_employees\u0027); pm.expect(raw).not.to.include(\u0027employee_id\u0027); });",
                                                                                    "pm.test(\u0027Query metadata exposes logical contract version\u0027, function () { const meta = pm.response.json().meta; pm.expect(meta.model).to.eql(\u0027employee-offboarding-candidate\u0027); pm.expect(meta.contractVersion).to.eql(\u00271.0\u0027); });"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "Unknown field is rejected",
                                      "request":  {
                                                      "method":  "GET",
                                                      "header":  [
                                                                     {
                                                                         "key":  "x-correlation-id",
                                                                         "value":  "{{correlationId}}"
                                                                     }
                                                                 ],
                                                      "url":  "{{baseUrl}}/offboarding/v1/employees?fields=employeeId,password\u0026page=1\u0026pageSize=100"
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027HTTP status is 400\u0027, function () { pm.response.to.have.status(400); });",
                                                                                    "pm.test(\u0027Invalid query uses normalized error contract\u0027, function () { const body = pm.response.json(); pm.expect(body.code).to.eql(\u0027INVALID_QUERY\u0027); pm.expect(body).to.have.property(\u0027message\u0027); pm.expect(body).to.have.property(\u0027correlationId\u0027); });"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "Page size above resource limit is rejected",
                                      "request":  {
                                                      "method":  "GET",
                                                      "header":  [
                                                                     {
                                                                         "key":  "x-correlation-id",
                                                                         "value":  "{{correlationId}}"
                                                                     }
                                                                 ],
                                                      "url":  "{{baseUrl}}/offboarding/v1/employees?page=1\u0026pageSize=1001"
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027HTTP status is 400\u0027, function () { pm.response.to.have.status(400); });",
                                                                                    "pm.test(\u0027Error code is INVALID_QUERY\u0027, function () { pm.expect(pm.response.json().code).to.eql(\u0027INVALID_QUERY\u0027); });"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  },
                                  {
                                      "name":  "Malformed filter does not echo submitted value",
                                      "request":  {
                                                      "method":  "GET",
                                                      "header":  [
                                                                     {
                                                                         "key":  "Authorization",
                                                                         "value":  "Bearer {{accessToken}}",
                                                                         "type":  "text"
                                                                     },
                                                                     {
                                                                         "key":  "x-correlation-id",
                                                                         "value":  "{{correlationId}}",
                                                                         "type":  "text"
                                                                     }
                                                                 ],
                                                      "url":  {
                                                                  "raw":  "{{baseUrl}}/offboarding/v1/employees?filter=email:invalid:private.person@iadb.org:extra",
                                                                  "host":  [
                                                                               "{{baseUrl}}"
                                                                           ],
                                                                  "path":  [
                                                                               "offboarding",
                                                                               "v1",
                                                                               "employees"
                                                                           ],
                                                                  "query":  [
                                                                                {
                                                                                    "key":  "filter",
                                                                                    "value":  "email:invalid:private.person@iadb.org:extra"
                                                                                }
                                                                            ]
                                                              }
                                                  },
                                      "event":  [
                                                    {
                                                        "listen":  "test",
                                                        "script":  {
                                                                       "type":  "text/javascript",
                                                                       "exec":  [
                                                                                    "pm.test(\u0027HTTP status is 400\u0027, function () { pm.response.to.have.status(400); });",
                                                                                    "pm.test(\u0027Error does not echo submitted PII\u0027, function () { pm.expect(pm.response.text()).not.to.include(\u0027private.person@iadb.org\u0027); });"
                                                                                ]
                                                                   }
                                                    }
                                                ]
                                  }
                              ]
                 }
